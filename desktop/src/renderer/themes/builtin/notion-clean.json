{
  "id": "notion-clean",
  "name": "Notion Clean",
  "version": "2.0.0",
  "author": "HDSI Team",
  "category": "custom",
  "description": "极简现代浅色主题，清爽阅读",
  "preview": "./previews/notion-clean.png",
  "colors": {
    "background": {
      "canvas": "#ffffff",
      "surface": "#fafafa",
      "elevated": "#f5f5f5",
      "highlight": "#efefef",
      "panel": "#f7f7f7"
    },
    "text": {
      "primary": "#1a1a1a",
      "secondary": "#4a4a4a",
      "tertiary": "#7a7a7a",
      "muted": "#a0a0a0"
    },
    "sidebar": {
      "bg": "#f7f7f7",
      "text": "#1a1a1a",
      "textDim": "#7a7a7a",
      "hover": "#efefef",
      "active": "#e5e5e5"
    },
    "accent": {
      "primary": "#3b82f6",
      "secondary": "#6366f1",
      "tertiary": "#8b5cf6"
    },
    "status": {
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#3b82f6"
    },
    "tracks": {
      "script": [
        "#3b82f6",
        "#60a5fa"
      ],
      "receive": [
        "#10b981",
        "#34d399"
      ],
      "send": [
        "#f59e0b",
        "#fbbf24"
      ],
      "alter": [
        "#ec4899",
        "#f472b6"
      ],
      "media": [
        "#8b5cf6",
        "#a78bfa"
      ],
      "state": [
        "#06b6d4",
        "#22d3ee"
      ]
    }
  },
  "typography": {
    "fontFamily": {
      "ui": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "display": "-apple-system, BlinkMacSystemFont, sans-serif",
      "mono": "'SF Mono', Consolas, monospace"
    },
    "fontSize": {
      "xs": "11px",
      "sm": "13px",
      "base": "14px",
      "md": "15px",
      "lg": "17px",
      "xl": "20px"
    },
    "fontWeight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.01em"
    }
  },
  "spacing": {
    "base": 10,
    "scale": 1.2,
    "density": "relaxed",
    "values": {
      "xs": "6px",
      "sm": "10px",
      "md": "16px",
      "lg": "20px",
      "xl": "28px",
      "2xl": "36px",
      "3xl": "48px"
    },
    "lineHeight": {
      "tight": 1.3,
      "normal": 1.6,
      "relaxed": 1.8
    }
  },
  "geometry": {
    "style": "rounded",
    "borderRadius": {
      "none": "0px",
      "minimal": "3px",
      "small": "6px",
      "medium": "12px",
      "large": "16px",
      "xlarge": "20px",
      "full": "999px"
    },
    "borderWidth": {
      "thin": "1px",
      "normal": "1px",
      "thick": "2px"
    },
    "outlineStyle": "solid"
  },
  "effects": {
    "shadowStyle": "minimal",
    "shadows": {
      "none": "none",
      "minimal": "0 1px 2px rgba(0,0,0,0.04)",
      "small": "0 2px 4px rgba(0,0,0,0.06)",
      "medium": "0 4px 8px rgba(0,0,0,0.08)",
      "large": "0 8px 16px rgba(0,0,0,0.1)",
      "xlarge": "0 16px 32px rgba(0,0,0,0.12)"
    },
    "glowEnabled": false,
    "glowIntensity": 0,
    "glowColors": {
      "accent": "none",
      "subtle": "none"
    },
    "gradientsEnabled": false,
    "gradientAngle": "135deg",
    "gradientStops": 2,
    "backdropBlur": "0px",
    "opacity": {
      "normal": 1.0,
      "muted": 0.6,
      "disabled": 0.4
    }
  },
  "animation": {
    "enabled": true,
    "speed": "normal",
    "defaultDuration": "200ms",
    "defaultEasing": "easeOut",
    "duration": {
      "instant": "0ms",
      "fast": "150ms",
      "normal": "200ms",
      "slow": "300ms",
      "slower": "400ms"
    },
    "easing": {
      "linear": "linear",
      "ease": "ease",
      "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
      "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)"
    }
  },
  "components": {
    "button": {
      "height": {
        "sm": "28px",
        "md": "32px",
        "lg": "36px"
      },
      "paddingX": {
        "sm": "12px",
        "md": "16px",
        "lg": "20px"
      },
      "borderRadius": "medium",
      "fontWeight": "medium",
      "shadow": "minimal",
      "hoverTransform": "none",
      "textTransform": "none"
    },
    "input": {
      "height": "32px",
      "paddingX": "12px",
      "borderRadius": "medium",
      "borderWidth": "thin",
      "fontSize": "base"
    },
    "panel": {
      "padding": "lg",
      "borderRadius": "large",
      "shadow": "minimal",
      "backdropBlur": "0px"
    },
    "card": {
      "padding": "xl",
      "borderRadius": "large",
      "shadow": "small",
      "borderWidth": "thin"
    },
    "track": {
      "height": "36px",
      "borderRadius": "medium",
      "shadow": "minimal",
      "separatorWidth": "1px"
    },
    "clip": {
      "padding": "md",
      "borderRadius": "medium",
      "borderWidth": "thin",
      "shadow": "small"
    }
  },
  "layout": {
    "sidebarWidth": {
      "browser": "260px",
      "inspector": "300px"
    },
    "detailHeight": "220px",
    "transportHeight": "52px",
    "minPanelWidth": "200px",
    "maxPanelWidth": "450px"
  },
  "presets": {
    "visualStyle": "flat",
    "densityPreset": "relaxed",
    "animationLevel": "minimal"
  },
  "colorScheme": "light"
}
