{
  "name": "hdsi-desktop",
  "version": "0.0.1-m5",
  "private": true,
  "description": "HDS-Interlude Typ0 — HDSI 对话生活连续剧本化桌面宿主（每剧本一个 Koishi worker）",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dist": "electron-builder --win",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "host": "node scripts/host.mjs",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node scripts/test-runtime.mjs",
    "verify:core": "node scripts/verify-runtime-core.mjs",
    "test:stale": "node scripts/test-stale-guards.cjs",
    "test:smoke": "node scripts/test-smoke.mjs",
    "test:bridge": "node scripts/test-bridge.mjs",
    "test:timeline": "node --test scripts/test-timeline-model.cjs",
    "test:ui": "node scripts/test-studio-ui.cjs",
    "test:ui-correctness": "node scripts/test-ui-correctness.cjs",
    "test:bfixes": "node scripts/test-b-fixes.cjs",
    "test:theme": "node scripts/test-theme-protocol.cjs",
    "test:ui-packs": "node scripts/test-ui-pack-preview.cjs",
    "test:interactions": "node scripts/test-theme-interactions.cjs",
    "test:compat-themes": "node scripts/test-compat-themes.cjs",
    "test:connect": "node scripts/test-connect-layout.cjs",
    "test:buttons": "node scripts/test-button-interactions.cjs",
    "test:uireview": "node scripts/ui-review-newfeatures.cjs",
    "test:ui-hierarchy": "node scripts/test-ui-hierarchy.cjs",
    "test:ui-refinement": "node scripts/test-ui-refinement.cjs",
    "test:ui-panel-polish": "node scripts/test-ui-panel-polish.cjs",
    "test:ui-spacing": "node scripts/test-ui-spacing.cjs",
    "test:connection-repair": "node scripts/test-connection-repair.mjs",
    "test:ui-connection-repair": "node scripts/test-ui-connection-repair.cjs",
    "test:ui-config-lock": "node scripts/test-ui-config-lock.cjs",
    "test:ui-providers": "node scripts/test-ui-providers.cjs",
    "test:importer": "node scripts/test-importer.mjs",
    "test:ui-bugfix-round": "node scripts/test-ui-bugfix-round.cjs",
    "test:ui-audit": "node scripts/test-ui-audit-round.cjs",
    "test:ui-import": "node scripts/test-ui-import.cjs"
  },
  "dependencies": {
    "@koishijs/console": "^5.30.11",
    "@koishijs/loader": "^4.6.0",
    "@koishijs/plugin-config": "^2.8.7",
    "@koishijs/plugin-console": "^5.30.11",
    "@koishijs/plugin-database-sqlite": "^4.7.0",
    "@koishijs/plugin-http": "^0.6.3",
    "@koishijs/plugin-proxy-agent": "^0.3.3",
    "@koishijs/plugin-server": "^3.2.4",
    "fflate": "0.8.3",
    "koishi": "^4.18.11",
    "koishi-plugin-adapter-onebot": "^6.9.4",
    "koishi-plugin-hds-interlude": "file:./vendor/koishi-plugin-hds-interlude-1.0.1-rc57v2.tgz",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.18.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "electron@33.4.11": true
  }
}
